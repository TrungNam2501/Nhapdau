<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NhapdauWeb</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Animate.css -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NhapdauWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Header Bar -->
    <header class="top-header">
        <div class="container d-flex align-items-center">
            <!-- Logo + Brand + Nav all on left -->
            <div class="d-flex align-items-center">
                <div class="header-brand">
                    <span class="brand-name">NhapdauWeb</span>
                    <span class="brand-sub">Hệ thống quản lý nhập dầu</span>
                </div>
                <div class="header-divider d-none d-md-block"></div>
                <nav class="header-nav d-none d-md-flex align-items-center">
                    <a class="header-nav-link active" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-database me-1"></i> BB Oil
                    </a>
                </nav>
            </div>
            <!-- User info + Logout -->
            @if (Context.Session.GetString("Username") != null)
            {
                <div class="d-none d-md-flex align-items-center ms-auto">
                    <span class="header-user-info">
                        <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("Username")
                    </span>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline ms-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-header-logout" title="Dang xuat">
                            <i class="bi bi-box-arrow-right me-1"></i> Dang xuat
                        </button>
                    </form>
                </div>
            }
            <!-- Mobile toggle -->
            <button class="navbar-toggler d-md-none ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-4 text-white"></i>
            </button>
        </div>
        <div class="collapse d-md-none" id="mobileNav">
            <div class="container pb-3">
                <a class="header-nav-link active d-block" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-database me-1"></i> BB Oil
                </a>
                @if (Context.Session.GetString("Username") != null)
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <span class="header-user-info">
                            <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("Username")
                        </span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-header-logout" title="Dang xuat">
                                <i class="bi bi-box-arrow-right me-1"></i> Dang xuat
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Toast container -->
    <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

    <div class="main-content">
        <div class="container-fluid px-4 px-lg-5">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer text-muted">
        <div class="container d-flex align-items-center justify-content-center">
            &copy; 2026 - NhapdauWeb
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
