@model NhapdauWeb.Models.OilViewModel
@{
    ViewData["Title"] = "BB Oil - Tra cứu dữ liệu";
}

<div class="mt-4">
    <h2 class="page-title mb-1">
        <i class="bi bi-droplet-half"></i> Tra cứu dữ liệu BB Oil
    </h2>
    <div class="separator"></div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert-modern alert-danger-modern mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert-modern alert-success-modern mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <!-- Dropdown chọn Barcode -->
    <div class="card-modern mb-4">
        <div class="card-header-modern">
            <i class="bi bi-search"></i> Chọn Barcode để tra cứu
        </div>
        <div class="card-body-modern">
            <form method="get" asp-action="Index">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-upc-scan"></i> Barcode (7 bit)</span>
                            <select name="selectedBarcode" id="selectedBarcode" class="form-select select2-dropdown"
                                    onchange="this.form.submit()">
                                <option value="">-- Chọn Barcode --</option>
                                @foreach (var item in Model.BarcodeList)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedBarcode))
    {
        <!-- Form nhập mới -->
        <div class="card-modern mb-4">
            <div class="card-header-modern">
                <i class="bi bi-plus-circle-fill"></i> Nhập mới HMI Barcode
            </div>
            <div class="card-body-modern">
                <form method="post" asp-action="Insert" id="insertForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="selectedBarcode" value="@Model.SelectedBarcode" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label for="newHmiBarcode" class="form-label">
                                <i class="bi bi-upc me-1"></i> HMI Barcode
                            </label>
                            <input type="text" class="form-control" id="newHmiBarcode" name="newHmiBarcode"
                                   placeholder="Nhập HMI Barcode..." required />
                            <div class="form-text">
                                Phải bắt đầu bằng <strong class="text-primary">@Model.SelectedBarcode</strong>.
                                Thời gian tự động = mới nhất + 5 phút.
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="cardNumber" class="form-label">
                                <i class="bi bi-person-badge me-1"></i> Số thẻ
                            </label>
                            <input type="text" class="form-control" id="cardNumber" name="cardNumber"
                                   placeholder="Nhập số thẻ nhân viên..." />
                            <div class="form-text">Số thẻ sẽ được lưu vào log.</div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary-custom w-100">
                                <i class="bi bi-plus-lg"></i> Nhập mới
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Thông tin lọc -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="alert-modern alert-info-modern mb-0 flex-grow-1">
                <i class="bi bi-funnel-fill"></i>
                <span>Đang lọc theo: <strong>@Model.SelectedBarcode</strong></span>
                <span class="stats-badge ms-2">
                    <i class="bi bi-list-ol"></i> @Model.OilRecords.Count bản ghi
                </span>
            </div>
        </div>

        <!-- Bảng dữ liệu -->
        <div class="table-modern">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <th><i class="bi bi-calendar-date"></i> Ngày nhập</th>
                        <th><i class="bi bi-clock"></i> Thời gian</th>
                        <th><i class="bi bi-activity"></i> Result ActiveUp</th>
                        <th><i class="bi bi-upc"></i> HMI Barcode</th>
                        <th><i class="bi bi-tag"></i> Barcode 7bit</th>
                        <th style="width: 90px;"><i class="bi bi-gear"></i> Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OilRecords.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
                                <p class="text-muted mt-2 mb-0">Không có dữ liệu.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var record in Model.OilRecords)
                        {
                            <tr>
                                <td><strong>@record.ID</strong></td>
                                <td>@record.Indat</td>
                                <td>@record.Intime</td>
                                <td>@record.Result_ActiveUp</td>
                                <td><code>@record.HMI_Barcode</code></td>
                                <td><code>@record.Barcode_left_7bit</code></td>
                                <td class="text-center">
                                    <form method="post" asp-action="Delete" style="display:inline;"
                                          onsubmit="return confirmDelete(@record.ID);">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@record.ID" />
                                        <input type="hidden" name="selectedBarcode" value="@Model.SelectedBarcode" />
                                        <input type="hidden" name="cardNumber" class="delete-card-number" value="" />
                                        <button type="submit" class="btn btn-danger-custom" title="Xóa bản ghi">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <!-- Select2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Select2 init
            $('.select2-dropdown').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Chọn Barcode --',
                allowClear: true
            });

            $('.select2-dropdown').on('select2:select select2:clear', function () {
                $(this).closest('form').submit();
            });

            // Client-side validation
            $('#insertForm').on('submit', function (e) {
                var barcode = '@Model.SelectedBarcode';
                var hmiBarcode = $('#newHmiBarcode').val();
                if (barcode && hmiBarcode && !hmiBarcode.toLowerCase().startsWith(barcode.toLowerCase())) {
                    e.preventDefault();
                    showNotification('HMI Barcode phải bắt đầu bằng "' + barcode + '"!', 'danger');
                    return false;
                }
            });

            // Auto-dismiss alerts after 5s
            setTimeout(function () {
                $('.alert-modern').each(function () {
                    $(this).css({ transition: 'opacity .5s, transform .5s', opacity: 0, transform: 'translateX(-20px)' });
                    var el = this;
                    setTimeout(function () { $(el).remove(); }, 500);
                });
            }, 5000);
        });

        function confirmDelete(id) {
            var cardNumber = prompt('Nhập số thẻ để xác nhận xóa bản ghi ID = ' + id + ':');
            if (cardNumber === null) return false;
            // Set card number in the hidden field
            event.target.closest('form').querySelector('.delete-card-number').value = cardNumber;
            return true;
        }

        function showNotification(msg, type) {
            var icon = type === 'danger' ? 'exclamation-triangle-fill' : 'check-circle-fill';
            var cls = type === 'danger' ? 'alert-danger-modern' : 'alert-success-modern';
            var html = '<div class="alert-modern ' + cls + ' mb-3"><i class="bi bi-' + icon + '"></i><span>' + msg + '</span></div>';
            $(html).insertAfter('.separator').delay(4000).queue(function () {
                $(this).css({ transition: 'opacity .5s', opacity: 0 });
                var el = this;
                setTimeout(function () { $(el).remove(); }, 500);
            });
        }
    </script>
}
