@model NhapdauWeb.Models.OilViewModel
@{
    ViewData["Title"] = "BB Oil - Tra cuu du lieu";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4 animate-fade-in-up">
        <h2 class="page-title mb-0">
            <i class="bi bi-droplet-half"></i> Nhập bù dữ liệu dầu
        </h2>
    </div>

    <div class="row mb-4 animate-fade-in-up animate-delay-1">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form method="get" asp-action="Index">
                        <label class="form-label fw-semibold text-muted mb-2">
                            <i class="bi bi-upc-scan me-1"></i> Barcode (7 bit)
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <select name="selectedBarcode" id="selectedBarcode" class="form-select select2-dropdown"
                                    onchange="this.form.submit()">
                                <option value="">-- Chon loại dầu --</option>
                                @foreach (var item in Model.BarcodeList)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedBarcode))
    {
        <!-- Form nhap moi -->
        <div class="card mb-4 animate-fade-in-up animate-delay-2">
            <div class="card-header bg-primary text-white d-flex align-items-center">
                <i class="bi bi-plus-circle-fill me-2"></i>
                <strong>Nhap moi HMI Barcode</strong>
            </div>
            <div class="card-body">
                <form method="post" asp-action="Insert" id="insertForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="selectedBarcode" value="@Model.SelectedBarcode" />
                    <div class="row align-items-end">
                        <div class="col-md-6">
                            <label for="newHmiBarcode" class="form-label fw-semibold">
                                <i class="bi bi-keyboard me-1"></i> HMI Barcode
                            </label>
                            <input type="text" class="form-control" id="newHmiBarcode" name="newHmiBarcode"
                                   placeholder="Nhap HMI Barcode (phai bat dau bang '@Model.SelectedBarcode')" required />
                            <div class="form-text">
                                Ky tu dau phai giong voi <strong>@Model.SelectedBarcode</strong>.
                                Thoi gian se tu dong = ban ghi moi nhat + 5 phut.
                            </div>
                        </div>
                        <div class="col-md-3 mt-3 mt-md-0">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Nhap moi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="info-badge mb-4 d-flex align-items-center animate-fade-in-up animate-delay-2">
            <i class="bi bi-funnel-fill me-2"></i>
            <span><strong>Dang loc theo:</strong> @Model.SelectedBarcode</span>
            <span class="mx-2">|</span>
            <span><strong>Tong so ban ghi:</strong> @Model.OilRecords.Count</span>
        </div>

        <div class="table-responsive animate-fade-in-up animate-delay-3">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <th><i class="bi bi-calendar3"></i> Ngay nhap</th>
                        <th><i class="bi bi-clock"></i> Thoi gian</th>
                        <th><i class="bi bi-activity"></i> Result ActiveUp</th>
                        <th><i class="bi bi-upc"></i> HMI Barcode</th>
                        <th><i class="bi bi-upc-scan"></i> Barcode 7bit</th>
                        <th style="width: 90px;"><i class="bi bi-gear"></i> Thao tac</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OilRecords.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Khong co du lieu.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var record in Model.OilRecords)
                        {
                            <tr>
                                <td><span class="fw-semibold">@record.ID</span></td>
                                <td>@record.Indat</td>
                                <td>@record.Intime</td>
                                <td>@record.Result_ActiveUp</td>
                                <td><code>@record.HMI_Barcode</code></td>
                                <td><code>@record.Barcode_left_7bit</code></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-danger btn-sm"
                                            onclick="confirmDelete(@record.ID, '@Model.SelectedBarcode')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-confirm">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Xac nhan xoa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Ban co chac chan muon xoa ban ghi ID = <strong id="deleteRecordId"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Huy
                </button>
                <form method="post" asp-action="Delete" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <input type="hidden" name="selectedBarcode" id="deleteBarcode" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3 me-1"></i> Xoa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        // Toast notification helper
        function showToast(type, title, message) {
            var iconClass = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            var toastClass = type === 'success' ? 'toast-success' : 'toast-error';
            var html = `
                <div class="toast toast-custom ${toastClass}" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
                    <div class="toast-header">
                        <i class="bi ${iconClass} me-2"></i>
                        <strong class="me-auto">${title}</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body">${message}</div>
                </div>`;
            var container = document.getElementById('toast-container');
            container.insertAdjacentHTML('beforeend', html);
            var toastEl = container.lastElementChild;
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', function () { toastEl.remove(); });
        }

        // Delete confirmation via modal
        function confirmDelete(id, barcode) {
            document.getElementById('deleteRecordId').textContent = id;
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteBarcode').value = barcode;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }

        $(document).ready(function () {
            // Select2
            $('.select2-dropdown').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Chon Barcode --',
                allowClear: true
            });

            $('.select2-dropdown').on('select2:select select2:clear', function () {
                $(this).closest('form').submit();
            });

            // Client-side validation for HMI Barcode prefix
            $('#insertForm').on('submit', function (e) {
                var barcode = '@Model.SelectedBarcode';
                var hmiBarcode = $('#newHmiBarcode').val();
                if (barcode && hmiBarcode && !hmiBarcode.toLowerCase().startsWith(barcode.toLowerCase())) {
                    e.preventDefault();
                    showToast('error', 'Loi', 'HMI Barcode phai bat dau bang "' + barcode + '"!');
                    return false;
                }
            });

            // Show toast from TempData
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <text>showToast('error', 'Loi', '@Html.Raw(Model.ErrorMessage.Replace("'", "\\'"))');</text>
            }
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <text>showToast('success', 'Thanh cong', '@Html.Raw(Model.SuccessMessage.Replace("'", "\\'"))');</text>
            }
        });
    </script>
}
